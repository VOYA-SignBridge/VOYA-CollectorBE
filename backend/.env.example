### Example environment variables for local development and deployment
# Database (Postgres)
DATABASE_URL=postgresql://signdb_user:signdb_pass@postgres:5432/signdb

# MinIO (object storage) - if not provided, uploads are skipped
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sign-dataset

# Dataset configuration
DATASET_VERSION=v1.0.0
DATASET_UPLOAD_REMOVE_LOCAL=0
DATASET_ROOT=/data/dataset

# Processing flags
FEATURE_DIM=126
SEQ_LEN=60
STRIDE=2
FPS_TARGET=30
AUG_PER_SEQ=8

# Inference backend
# - tensorflow: expects MODEL_ROOT to contain model_manifest.json + artifact
# - pytorch: set a checkpoint path (.pth/.pth.tar)
INFERENCE_BACKEND=tensorflow
MODEL_ROOT=/data/models/active
MODEL_ARTIFACT_PATH=
MODEL_LABEL_MAP_PATH=
TORCH_HIDDEN=256
TORCH_LAYERS=2

# Uvicorn host/port
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
