# Example environment variables for `docker-compose.yml` (repo root)
# Safe defaults only (do NOT put production secrets here).

# Database (compose postgres service)
DATABASE_URL=postgresql://signuser:signpass@postgres:5432/signdb

# Celery / Redis (compose redis service)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Dataset + models (compose mounts these paths)
DATASET_ROOT=/dataset
MODEL_ROOT=/models/active

# MinIO (compose minio service)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sign-dataset

# Dataset publication/versioning
DATASET_VERSION=v1.0.0
DATASET_UPLOAD_REMOVE_LOCAL=0

# Processing flags
FEATURE_DIM=126
SEQ_LEN=60
STRIDE=2
FPS_TARGET=30

RESIZE_W=480
RESIZE_H=480
AUG_PER_SEQ=2
VIDEO_AUG_PER_SEQ=8
VIDEO_COMPLETENESS=0.8
SPEED_VARIANTS=1.0
MAX_SAMPLES_PER_CLASS=80

# Inference (PyTorch)
INFERENCE_BACKEND=pytorch
MODEL_ARTIFACT_PATH=/models/active/torch_vn_all_last_v3/model_best.pth.tar

# Optional stability gating
INFER_MIN_ENERGY=0.00010
INFER_MIN_MOTION=0.00050
